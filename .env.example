# Copia este archivo como .env y pega TU cadena de conexión de Neon.
# Neon la entrega como postgresql://...  -> cámbiale el inicio por postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://usuario:clave@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Firma de las sesiones: una cadena larga y aleatoria (python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria

# Envío de los códigos: consola (los muestra en la terminal) | smtp | brevo
EMAIL_BACKEND=consola
EMAIL_FROM=tu-correo@gmail.com
EMAIL_FROM_NAME=AI Quoter

# Si EMAIL_BACKEND=brevo (recomendado en Render): API key de https://app.brevo.com
BREVO_API_KEY=

# Si EMAIL_BACKEND=smtp (solo en local; Render gratis bloquea SMTP). Con Gmail usa una "contraseña de aplicación".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
